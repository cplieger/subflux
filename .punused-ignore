# reach Unwrap through an anonymous interface inside the stdlib. Verified by
# renaming: provider/registry.go:255 appends &RegistryError{} to a []error.
# api.RateLimitError is returned as an error from httpwire.go:72 and
# betaseries.go:180; RegistryError.Unwrap is what lets registry_test.go:118's
# errors.Is(err, cause) find the provider's own failure.
