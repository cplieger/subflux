# config_validate_search.go:25,:54 plus config_validate.go:142 hand
# *FieldDependencyError to ve.Add and to fmt.Errorf's %w, so the message is
# rendered through the error interface on the startup log and the config
# response body. Deleting either Error breaks the build at those returns.
method (*RateLimitError).Error
method (*RegistryError).Error
method (*RegistryError).Unwrap
method (*ValidationError).Error
method (*FieldDependencyError).Error

