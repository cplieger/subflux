{
  "type": "module",
  "scripts": {
    "typecheck": "tsc -project tsconfig.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check ../..",
    "lint:fix": "eslint . --fix && prettier --write ../..",
    "lint:knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "25.9.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.6",
    "html-validate": "11.8.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@cplieger/actions": "3.1.3",
    "@cplieger/fetch": "2.1.2",
    "@cplieger/keyenc": "1.0.5",
    "@cplieger/reactive": "1.3.1",
    "@cplieger/ui-primitives": "3.0.5"
  },
  "overrides": {
    "rolldown": "1.2.1 || >=1.2.3",
    "typed-rest-client": {
      "qs": "6.15.3"
    }
  }
