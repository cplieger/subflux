{
  "type": "module",
  "scripts": {
    "typecheck": "tsc -project tsconfig.json && tsc -project tsconfig.worker.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check ../..",
    "lint:fix": "eslint . --fix && prettier --write ../..",
    "lint:knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "html-validate": "11.16.2",
    "knip": "6.40.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@cplieger/actions": "3.2.0-dev.2",
    "@cplieger/fetch": "2.2.1",
    "@cplieger/keyenc": "1.1.0-dev.1",
    "@cplieger/reactive": "2.2.0-dev.1",
    "@cplieger/sse": "1.1.1",
    "@cplieger/ui-primitives": "3.2.0-dev.2"
  },
  "overrides": {
    "qs": "^6.15.2",
    "rolldown": "1.2.1 || >=1.2.3"
  }
}
